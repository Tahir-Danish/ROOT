{
  "input_dimensions": [
    1,
    3,
    224,
    224
  ],
  "batch_size": 1,
  "channels": 3,
  "height": 224,
  "width": 224,
  "layout": "NCHW",
  "color_space": "RGB",
  "resize": {
    "evaluation_resize": [
      256,
      256
    ],
    "evaluation_crop": [
      224,
      224
    ],
    "direct_resize_option": [
      224,
      224
    ],
    "interpolation": "BILINEAR"
  },
  "normalization": {
    "raw_pixel_range": "[0, 255]",
    "divide_by": 255.0,
    "float_range": "[0.0, 1.0]",
    "mean": [
      0.485,
      0.456,
      0.406
    ],
    "std": [
      0.229,
      0.224,
      0.225
    ],
    "formula": "(pixel_val / 255.0 - mean[c]) / std[c]"
  },
  "output": {
    "tensor_name": "probabilities",
    "shape": [
      1,
      10
    ],
    "semantics": "Softmax probability distribution over 10 specialist classes"
  }
}